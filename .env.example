# Serving port (default 8000). NOTE: on Baseten docker_server, the platform injects
# PORT=8080 (reserved for its proxy); pin PORT=8000 in the start_command there.
PORT=8000

# Muna access key. Required to load predictors; the integration tests
# (tests/serving.rs) also read it from this file when spawning the server.
MUNA_ACCESS_KEY=
